# Claude API key (https://console.anthropic.com). Leave unset and use --fake to run offline.
ANTHROPIC_API_KEY=

# Where leads are stored. Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db
LEADSMITH_DATABASE_URL=sqlite:///leadsmith.db

# Clients of the REST API must send this value in the X-API-Key header.
LEADSMITH_API_KEY=change-me

# "claude" for real analysis, "fake" for the offline heuristic analyzer.
LEADSMITH_LLM_MODE=claude
LEADSMITH_CLAUDE_MODEL=claude-opus-5-5
LEADSMITH_CONCURRENCY=5
LEADSMITH_PROFILE_PATH=agency_profile.yaml
